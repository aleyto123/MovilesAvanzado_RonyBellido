                        <label opaque="NO" contentMode="left" fixedFrame="YES" text="Resultado" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="res-title"><rect key="frame" x="30" y="70" width="333" height="34"/><fontDescription key="fontDescription" type="boldSystem" pointSize="28"/><color key="textColor" systemColor="systemBlueColor"/></label>
                        <label opaque="NO" contentMode="left" fixedFrame="YES" text="Subtotal" translatesAutoresizingMaskIntoConstraints="NO" id="res-l1"><rect key="frame" x="35" y="155" width="150" height="24"/><fontDescription key="fontDescription" type="system" pointSize="17"/></label><label opaque="NO" contentMode="left" fixedFrame="YES" text="-" translatesAutoresizingMaskIntoConstraints="NO" id="res-v1"><rect key="frame" x="200" y="155" width="158" height="24"/><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
