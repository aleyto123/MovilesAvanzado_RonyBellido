<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="nav-000">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="nav-scene">
            <objects>
                <navigationController id="nav-000" sceneMemberID="viewController">
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="nav-bar"/>
                    <connections>
                        <segue destination="new-000" kind="relationship" relationship="rootViewController" id="nav-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="nav-first" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="new-scene">
            <objects>
                <viewController id="new-000" customClass="NuevaVentaViewController" customModule="Semana06_02" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="new-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <subviews>
                            <label opaque="NO" contentMode="left" fixedFrame="YES" text="Nueva Venta" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="new-title">
                                <rect key="frame" x="30" y="55" width="333" height="34"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="28"/>
                                <color key="textColor" systemColor="systemBlueColor"/>
                            </label>
                            <label opaque="NO" contentMode="left" fixedFrame="YES" text="Electrodoméstico:" translatesAutoresizingMaskIntoConstraints="NO" id="new-l1"><rect key="frame" x="35" y="125" width="323" height="21"/><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                            <textField opaque="NO" contentMode="scaleToFill" fixedFrame="YES" placeholder="Ej. Refrigeradora" borderStyle="roundedRect" translatesAutoresizingMaskIntoConstraints="NO" id="new-t1"><rect key="frame" x="35" y="150" width="323" height="36"/><textInputTraits key="textInputTraits"/></textField>
                            <label opaque="NO" contentMode="left" fixedFrame="YES" text="Precio unitario:" translatesAutoresizingMaskIntoConstraints="NO" id="new-l2"><rect key="frame" x="35" y="200" width="323" height="21"/><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                            <textField opaque="NO" contentMode="scaleToFill" fixedFrame="YES" placeholder="0.00" borderStyle="roundedRect" translatesAutoresizingMaskIntoConstraints="NO" id="new-t2"><rect key="frame" x="35" y="225" width="323" height="36"/><textInputTraits key="textInputTraits" keyboardType="decimalPad"/></textField>
                            <label opaque="NO" contentMode="left" fixedFrame="YES" text="Cantidad:" translatesAutoresizingMaskIntoConstraints="NO" id="new-l3"><rect key="frame" x="35" y="275" width="323" height="21"/><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                            <textField opaque="NO" contentMode="scaleToFill" fixedFrame="YES" placeholder="1" borderStyle="roundedRect" translatesAutoresizingMaskIntoConstraints="NO" id="new-t3"><rect key="frame" x="35" y="300" width="323" height="36"/><textInputTraits key="textInputTraits" keyboardType="numberPad"/></textField>
                            <label opaque="NO" contentMode="left" fixedFrame="YES" text="Meses:" translatesAutoresizingMaskIntoConstraints="NO" id="new-l4"><rect key="frame" x="35" y="350" width="323" height="21"/><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                            <textField opaque="NO" contentMode="scaleToFill" fixedFrame="YES" placeholder="12" borderStyle="roundedRect" translatesAutoresizingMaskIntoConstraints="NO" id="new-t4"><rect key="frame" x="35" y="375" width="323" height="36"/><textInputTraits key="textInputTraits" keyboardType="numberPad"/></textField>
                            <label opaque="NO" contentMode="left" fixedFrame="YES" text="Interés mensual (%):" translatesAutoresizingMaskIntoConstraints="NO" id="new-l5"><rect key="frame" x="35" y="425" width="323" height="21"/><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                            <textField opaque="NO" contentMode="scaleToFill" fixedFrame="YES" placeholder="1.0" borderStyle="roundedRect" translatesAutoresizingMaskIntoConstraints="NO" id="new-t5"><rect key="frame" x="35" y="450" width="323" height="36"/><textInputTraits key="textInputTraits" keyboardType="decimalPad"/></textField>
                            <button opaque="NO" contentMode="scaleToFill" fixedFrame="YES" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="new-calc"><rect key="frame" x="35" y="520" width="323" height="48"/><buttonConfiguration key="configuration" style="filled" title="Calcular"/></button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="new-safe"/><color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="Nueva Venta" id="new-nav"/>
                    <connections>
                        <outlet property="txtElectrodomestico" destination="new-t1" id="out-1"/><outlet property="txtPrecioUnitario" destination="new-t2" id="out-2"/><outlet property="txtCantidad" destination="new-t3" id="out-3"/><outlet property="txtMeses" destination="new-t4" id="out-4"/><outlet property="txtInteresMensual" destination="new-t5" id="out-5"/>
                        <action selector="calcular:" destination="new-000" eventType="touchUpInside" id="act-calc"/>
                        <segue destination="result-000" kind="show" identifier="showResultado" id="show-result"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="new-first" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
        <scene sceneID="result-scene">
            <objects>
                <viewController id="result-000" customClass="ResultadoViewController" customModule="Semana06_02" customModuleProvider="target" sceneMemberID="viewController">
