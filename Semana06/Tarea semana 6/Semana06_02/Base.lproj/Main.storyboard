                        <label opaque="NO" contentMode="left" fixedFrame="YES" text="Base" translatesAutoresizingMaskIntoConstraints="NO" id="res-l3"><rect key="frame" x="35" y="245" width="150" height="24"/><fontDescription key="fontDescription" type="system" pointSize="17"/></label><label opaque="NO" contentMode="left" fixedFrame="YES" text="-" translatesAutoresizingMaskIntoConstraints="NO" id="res-v3"><rect key="frame" x="200" y="245" width="158" height="24"/><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
                        <label opaque="NO" contentMode="left" fixedFrame="YES" text="Intereses" translatesAutoresizingMaskIntoConstraints="NO" id="res-l4"><rect key="frame" x="35" y="290" width="150" height="24"/><fontDescription key="fontDescription" type="system" pointSize="17"/></label><label opaque="NO" contentMode="left" fixedFrame="YES" text="-" translatesAutoresizingMaskIntoConstraints="NO" id="res-v4"><rect key="frame" x="200" y="290" width="158" height="24"/><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
                        <label opaque="NO" contentMode="left" fixedFrame="YES" text="Total" translatesAutoresizingMaskIntoConstraints="NO" id="res-l5"><rect key="frame" x="35" y="360" width="150" height="26"/><fontDescription key="fontDescription" type="boldSystem" pointSize="19"/></label><label opaque="NO" contentMode="left" fixedFrame="YES" text="-" translatesAutoresizingMaskIntoConstraints="NO" id="res-v5"><rect key="frame" x="200" y="360" width="158" height="26"/><fontDescription key="fontDescription" type="boldSystem" pointSize="19"/></label>
                        <label opaque="NO" contentMode="left" fixedFrame="YES" text="Cuota mensual" translatesAutoresizingMaskIntoConstraints="NO" id="res-l6"><rect key="frame" x="35" y="410" width="170" height="26"/><fontDescription key="fontDescription" type="boldSystem" pointSize="19"/><color key="textColor" systemColor="systemBlueColor"/></label><label opaque="NO" contentMode="left" fixedFrame="YES" text="-" translatesAutoresizingMaskIntoConstraints="NO" id="res-v6"><rect key="frame" x="200" y="410" width="158" height="26"/><fontDescription key="fontDescription" type="boldSystem" pointSize="19"/><color key="textColor" systemColor="systemBlueColor"/></label>
                    </subviews><viewLayoutGuide key="safeArea" id="result-safe"/><color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/></view>
                    <navigationItem key="navigationItem" title="Resultado" id="result-nav"/>
                    <connections><outlet property="lblSubtotal" destination="res-v1" id="r1"/><outlet property="lblIGV" destination="res-v2" id="r2"/><outlet property="lblBase" destination="res-v3" id="r3"/><outlet property="lblIntereses" destination="res-v4" id="r4"/><outlet property="lblTotal" destination="res-v5" id="r5"/><outlet property="lblCuota" destination="res-v6" id="r6"/></connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="result-first" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources><systemColor name="systemBackgroundColor"><color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor><systemColor name="systemGroupedBackgroundColor"><color white="0.949" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></systemColor><systemColor name="systemBlueColor"><color red="0.0" green="0.478" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></systemColor></resources>
</document>
