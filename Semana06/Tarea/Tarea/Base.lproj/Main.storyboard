                        <outlet property="txtPrecioUnitario" destination="new-t2" id="out-2"/>
                        <outlet property="txtCantidad" destination="new-t3" id="out-3"/>
                        <outlet property="txtMeses" destination="new-t4" id="out-4"/>
                        <outlet property="txtInteresMensual" destination="new-t5" id="out-5"/>
                        <segue destination="result-000" kind="show" identifier="showResultado" id="show-result"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="new-first" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>

